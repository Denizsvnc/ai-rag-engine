# Server Configuration
PORT=3000
NODE_ENV=development

# ==============================================================================
# ENTERPRISE DATA PRIVACY & COMPLIANCE GUARD
# ==============================================================================
# Set to 'false' (default) to strictly prevent proprietary corporate data and prompts
# from being transmitted to external public/community open-source LLM routers (e.g. OpenRouter free tier).
# Set to 'true' only if your organization permits routing requests to public open-source cloud APIs.
ALLOW_PUBLIC_OPENSOURCE_LLM=false

# ==============================================================================
# 1. PRIVATE & ON-PREMISE LLM CONFIGURATION (vLLM, TGI, LocalAI, Enterprise Gateway)
# ==============================================================================
# Use these settings if your company hosts private, on-premise, or self-hosted LLMs.
# Fully compatible with any OpenAI-compatible /v1/chat/completions endpoint.
PRIVATE_LLM_ENDPOINT=http://localhost:8000/v1/chat/completions
# Optional: API key or Bearer token (leave empty if on a secured internal network)
PRIVATE_LLM_API_KEY=
# Fast/Economical model on your private cluster
PRIVATE_LLM_MODEL_FAST=llama-3.2-3b-instruct
# Smart/High-reasoning model on your private cluster
PRIVATE_LLM_MODEL_SMART=llama-3.1-70b-instruct
# Optional: Extra HTTP headers in JSON format (e.g. {"X-Corporate-ID": "corp_42"})
# PRIVATE_LLM_HEADERS={"X-Tenant-ID": "finance"}

# ==============================================================================
# 2. SELF-HOSTED OLLAMA CONFIGURATION (Local GPU / Internal Server)
# ==============================================================================
# Host address of your internal Ollama instance
OLLAMA_HOST=http://localhost:11434
# Fast model tag (e.g. for simple extraction, classification, FAQ)
OLLAMA_MODEL_FAST=llama3.2:3b
# Smart model tag (e.g. for deep reasoning, tool planning, complex RAG)
OLLAMA_MODEL_SMART=deepseek-r1:8b

# ==============================================================================
# 3. PROPRIETARY CLOUD LLM PROVIDERS
# ==============================================================================
# --- OpenAI Configuration ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_SMART=gpt-4o

# --- Google Gemini Configuration ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_FAST=gemini-1.5-flash
GEMINI_MODEL_SMART=gemini-1.5-pro

# ==============================================================================
# 4. EXTERNAL OPEN-SOURCE FALLBACK (OpenRouter)
# Note: Requires ALLOW_PUBLIC_OPENSOURCE_LLM=true to be active!
# ==============================================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL_FAST=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_MODEL_SMART=deepseek/deepseek-r1:free

# ==============================================================================
# 5. EXTERNAL DATA ADAPTERS (Optional)
# ==============================================================================
# DATABASE_URL=postgresql://user:password@localhost:5432/rag_db
# FAQ_ENDPOINT_URL=https://api.example.com/faqs

# Authentication: generate independent random secrets (32+ bytes in production).
# Never use these empty values in production; startup will fail closed.
JWT_SECRET=
CONFIRMATION_SECRET=
JWT_ISSUER=ai-rag-engine
JWT_AUDIENCE=ai-rag-engine-api
# Explicit local development only. Production rejects this option.
ALLOW_ANONYMOUS_DEV_AUTH=false
# Required shared nonce store for SDK engines with mutating tools in production.
# All instances must share the same durable, noeviction Redis database.
# CONFIRMATION_REDIS_URL=redis://localhost:6379
