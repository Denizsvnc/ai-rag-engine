{
  "name": "ai-rag-engine",
  "version": "2.1.0",
  "description": "Lightweight, enterprise-ready Agentic RAG engine with local SML intent routing, zero-token semantic FAQ matching, multi-tiered LLM failover, and OWASP prompt injection defense.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "build:types": "tsc --emitDeclarationOnly",
    "build:js": "node tools/build.mjs",
    "build": "npm run build:types && npm run build:js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/api/server.js",
    "test": "tsx test/run-all.ts",
    "benchmark": "tsx test/performance/smoke-benchmark.ts",
    "example:ecommerce": "tsx src/examples/02-ecommerce-with-tools/index.ts",
    "example:minimal": "tsx src/examples/01-minimal-express/index.ts",
    "test:security": "node --import tsx --test test/security/*.test.ts test/unit/security/*.test.ts test/integration/security-boundaries.test.ts test/integration/distributed-confirmation.test.ts test/unit/governed-tools.test.ts",
    "db:migrate": "node dist/scripts/migrate-vector.js",
    "start:worker": "node dist/worker.js",
    "prepack": "npm run build",
    "test:consumer": "node test/consumer/run.mjs"
  },
  "keywords": [
    "rag",
    "agentic-rag",
    "sml",
    "semantic-routing",
    "vector-search",
    "prompt-injection",
    "ollama",
    "vllm",
    "openai",
    "gemini",
    "openrouter"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "bullmq": "6.7.2",
    "dotenv": "16.6.1",
    "express": "5.3.0",
    "ioredis": "6.0.0",
    "lru-cache": "10.4.3",
    "pg": "8.23.1",
    "zod": "4.6.7",
    "@types/pg": "8.23.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5"
  },
  "devDependencies": {
    "@types/dotenv": "6.1.1",
    "esbuild": "0.28.2",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "bin": {
    "ai-rag-server": "dist/api/server.js",
    "ai-rag-worker": "dist/worker.js",
    "ai-rag-migrate": "dist/scripts/migrate-vector.js"
  }
}
