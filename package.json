{
  "name": "@denizsvnc/ai-rag-engine",
  "version": "2.2.1",
  "description": "TypeScript RAG engine with pluggable providers, local semantic routing, tenant-aware retrieval, and durable document ingestion.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/USAGE.md",
    "docs/RELEASING.md"
  ],
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build:js": "node tools/build.mjs",
    "build": "npm run clean && npm run build:types && npm run build:js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/api/server.js",
    "test": "tsx test/run-all.ts",
    "benchmark": "tsx test/performance/smoke-benchmark.ts",
    "example:ecommerce": "tsx src/examples/02-ecommerce-with-tools/index.ts",
    "example:minimal": "tsx src/examples/01-minimal-express/index.ts",
    "test:security": "node --import tsx --test test/security/*.test.ts test/unit/security/*.test.ts test/integration/security-boundaries.test.ts test/integration/distributed-confirmation.test.ts test/unit/governed-tools.test.ts",
    "db:migrate": "node dist/scripts/migrate-vector.js",
    "start:worker": "node dist/worker.js",
    "prepack": "npm run build",
    "test:consumer": "node test/package/run.mjs",
    "clean": "node tools/clean.mjs",
    "test:consumer:integration": "node test/consumer/run.mjs",
    "test:package": "npm run build && node tools/verify-package.mjs"
  },
  "keywords": [
    "rag",
    "agentic-rag",
    "sml",
    "semantic-routing",
    "vector-search",
    "prompt-injection",
    "ollama",
    "vllm",
    "openai",
    "gemini",
    "openrouter"
  ],
  "author": "Denizsvnc (https://github.com/Denizsvnc)",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "bullmq": "6.7.2",
    "dotenv": "16.6.1",
    "express": "5.3.0",
    "ioredis": "6.0.0",
    "lru-cache": "10.4.3",
    "pg": "8.23.1",
    "zod": "4.6.7",
    "@types/pg": "8.23.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "bin": {
    "ai-rag-server": "dist/api/server.js",
    "ai-rag-worker": "dist/worker.js",
    "ai-rag-migrate": "dist/scripts/migrate-vector.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Denizsvnc/ai-rag-engine.git"
  },
  "homepage": "https://github.com/Denizsvnc/ai-rag-engine#readme",
  "bugs": {
    "url": "https://github.com/Denizsvnc/ai-rag-engine/issues"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
